{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Nunc Pro Tune",
  "version": "0.2.0",
  "identifier": "io.github.nuncprotunc7.nuncprotune",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nunc Pro Tune",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Nunc Pro Tune contributors",
    "shortDescription": "Open-source DAW for game music",
    "longDescription": "Nunc Pro Tune is a free, open-source digital audio workstation for making game music, controllable by Claude through MCP.",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "category": "Music",
    "copyright": "Copyright (C) 2026 Nunc Pro Tune contributors. Licensed under GPL-3.0-or-later.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFNEYwNTlDOTk0MDg3QzkKUldUSmgwQ1puQVZQSHVDakQxZ2FNeUx5eG1HSy9vQzdPMEVDaVUwVTlGMnlOTUQrT0tXaTJ5bVkK",
      "endpoints": [
        "https://github.com/NuncProTunc7/digital-audio-workstation/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
